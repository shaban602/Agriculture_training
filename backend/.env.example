PORT=5000
NODE_ENV=production
DB_HOST=localhost
DB_USER=agriculture_app
DB_PASSWORD=replace-with-a-unique-database-password
DB_NAME=agriculture_training_technical_system_database
DB_PORT=3306
# Set to true for cloud databases that require TLS, such as TiDB Cloud.
# DB_SSL=true
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_ORIGIN=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
COOKIE_SAME_SITE=lax
BACKUP_RETENTION_DAYS=30
# Optional absolute path for SQL dumps.
# BACKUP_DIR=D:/secure-backups/agriculture